# Copia este archivo como .env y ajusta los valores.
# El .env real NUNCA se sube al repositorio (está en .gitignore).

# Servidor
PORT=4000

# MongoDB Atlas — URI del cluster. MONGO_URI es el nombre canónico;
# MONGODB_URI también se acepta para servicios configurados con ese nombre.
# Para que todos vean los MISMOS datos, usen la MISMA URL (la comparte el
# líder del equipo). Si cada uno usa su cluster propio, verá datos vacíos.
MONGO_URI=
MONGO_DATABASE=labficat_dv

# Seguridad (JWT) — cualquier cadena larga y aleatoria (no compartir).
JWT_SECRET=
JWT_EXPIRES=12h

# Orígenes permitidos, separados por coma (Vite corre en 5174).
# En Render agrega la URL asignada al frontend, por ejemplo https://tu-app.onrender.com
FRONTEND_URL=http://localhost:5174

# URL para abrir el seguimiento y la firma desde el correo.
# Para clientes externos debe ser la URL pública del frontend.
PUBLIC_FRONTEND_URL=

# gmail-smtp para pruebas locales, gmail-api para Gmail en Render, o resend.
MAIL_PROVIDER=resend
GMAIL_USER=labficat2026@gmail.com
GMAIL_APP_PASSWORD=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# MAIL_FROM debe pertenecer a un dominio verificado en Resend.
RESEND_API_KEY=
MAIL_FROM=
