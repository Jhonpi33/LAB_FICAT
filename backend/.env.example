# Copia este archivo como .env y ajusta los valores.
# El .env real NUNCA se sube al repositorio (está en .gitignore).

# Servidor
PORT=4000

# MongoDB Atlas — URL de conexión del cluster.
# Para que todos vean los MISMOS datos, usen la MISMA URL (la comparte el
# líder del equipo). Si cada uno usa su cluster propio, verá datos vacíos.
MONGO_URI=

# Seguridad (JWT) — cualquier cadena larga y aleatoria (no compartir).
JWT_SECRET=
JWT_EXPIRES=12h

# Orígenes permitidos, separados por coma (Vite corre en 5174).
# En Render agrega la URL asignada al frontend, por ejemplo https://tu-app.onrender.com
FRONTEND_URL=http://localhost:5174
